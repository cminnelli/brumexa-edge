# URL del servidor central brumexa-rag-api-v2 (el que emite los tokens de LiveKit)
RAG_API_URL=http://localhost:4000

# Credenciales del dispositivo — se crean/rotan desde brumexa-admin-v2
# (Devices → crear dispositivo, o generar el script de aprovisionamiento)
BRUMEXA_DEVICE_ID=
BRUMEXA_API_KEY=

# Opcional: fallback si /auth/device no devuelve businessId (no debería pasar)
DEFAULT_BUSINESS_ID=

PORT=3000

# SSID del AP de fallback (sin WiFi configurado) — también usado para debug
# local sin internet vía GET /local. Ver lib/wifi.js y lib/local-debug.js.
WIFI_AP_SSID=brumexa-local

# Contraseña del AP de fallback (mínimo 8 caracteres, la exige NetworkManager)
WIFI_AP_PASS=brumexa123

# IP fija de la Pi mientras está en modo AP — se entra por
# http://<esta IP>:3000/setup para cargar el WiFi real
WIFI_AP_IP=10.42.0.1

# Ganancia del micrófono (multiplicador de software, 1.0 = sin boost, 4.0 = 12dB)
MIC_GAIN=4.0

# Umbral (dBFS) para considerar que el mic/parlante "está hablando" — un solo
# valor conectado a DOS cosas: el texto del log en consola en modo nativo Pi
# ("empezó/dejó de hablar") Y el LED (corta el breathing, pasa a "hablando").
# Más alto (ej. -15) = menos sensible, hace falta hablar más fuerte.
# Más bajo (ej. -40) = más sensible, pero ojo: por debajo de -30 empieza a
# dispararse con ruido ambiente (ventilador, impresora 3D cerca, etc.).
# Ajustable en vivo desde /configuracion (sin reiniciar) o acá para el default.
MIC_TALK_THRESHOLD_DBFS=-25

# Corte automático de la sesión LiveKit por silencio (milisegundos) — si pasan
# estos ms sin que NI vos NI el agente crucen el umbral de arriba, la sesión
# se desconecta sola (evita dejar el mic publicando y el VAD del agente
# corriendo indefinidamente si alguien se olvida la sesión prendida).
# 0 = desactivado. Ajustable en vivo desde /configuracion → Sonido.
SILENCE_DISCONNECT_MS=20000

# Gate de ruido sobre el audio publicado a LiveKit (ver lib/mic-speech-gate.js
# y _publishMic en lib/livekit-session.js) — mientras el detector de voz (el
# mismo que mueve el LED, umbral+piso ambiente de arriba) no confirma que
# estás hablando, el audio que sale hacia el agente se atenúa en vez de
# mandarse crudo. Antes de esto, TODO el piso de ruido del ambiente se
# publicaba siempre, sin filtrar. Ajustable en vivo desde /configuracion → Sonido.
MIC_GATE_ENABLED=true
# dB de atenuación aplicados mientras el gate está cerrado. -90 ≈ silencio
# digital total. Subilo (ej. -30) si alguna vez preferís mandar un piso más
# tenue en vez de silencio puro.
MIC_GATE_ATTENUATION_DB=-90
# Cuánto audio previo (ms) se guarda en un buffer circular y se manda de
# golpe al abrir el gate, para no perder el arranque de la palabra mientras
# el detector todavía está confirmando (~300ms) que es voz real.
MIC_PREROLL_MS=500

# Ganancia de la voz del agente LiveKit al parlante (1.0 = sin boost).
# El HAT de audio de la Pi se queda corto al 100% de ALSA — este boost
# multiplica las muestras PCM antes de aplay. Las grabaciones locales ya
# se normalizan solas al guardarse (ver recorder.js) y suenan más fuerte
# que esto por default — subí este valor si la voz del agente queda baja
# en comparación. Ajustable también desde /configuracion sin tocar SSH.
# Valores muy altos pueden distorsionar (clipping).
SPEAKER_GAIN=5.0
